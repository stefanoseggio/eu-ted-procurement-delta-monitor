{
    "name": "eu-ted-procurement-delta-monitor",
    "version": "1.0.0",
    "type": "module",
    "description": "EU TED (Tenders Electronic Daily) Procurement Delta Monitor: tracks new tenders, contract awards, and status changes across all 27 EU member states via TED's official public Search API, pay-per-event.",
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "apify": "^3.7.0"
    },
    "devDependencies": {
        "@apify/eslint-config": "^2.0.0",
        "@apify/tsconfig": "^0.2.0",
        "@types/node": "^24.0.0",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^10.1.5",
        "globals": "^17.0.0",
        "prettier": "^3.5.3",
        "tsx": "^4.20.3",
        "typescript": "^6.0.0",
        "typescript-eslint": "^8.58.0",
        "vitest": "^5.0.0"
    },
    "scripts": {
        "start": "node dist/main.js",
        "start:prod": "node dist/main.js",
        "start:dev": "tsx src/main.ts",
        "build": "tsc",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run"
    },
    "author": "Stefano",
    "license": "Apache-2.0",
    "keywords": [
        "apify",
        "actor",
        "ted",
        "tenders electronic daily",
        "eu procurement",
        "public procurement",
        "european tender alerts",
        "contract awards",
        "cpv codes",
        "government contracts",
        "procurement intelligence",
        "business development leads",
        "delta",
        "change detection",
        "b2b data",
        "eu member states"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/stefanoseggio/eu-ted-procurement-delta-monitor.git"
    },
    "homepage": "https://apify.com/stefano_seggio/eu-ted-procurement-delta-monitor"
}
